extends base

//- Sidebar mixin
mixin navItem(link, text, icon, active)
  li(class=active ? 'side-nav--active' : '')
    a(href=link)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content

  main.main
    .user-view

      //- ============================
      //- SIDEBAR
      //- ============================

      nav.user-view__menu

        ul.side-nav

          +navItem(
            '/me',
            'Settings',
            'settings',
            activePage == 'settings'
          )

          +navItem(
            '/my-tours',
            'My bookings',
            'briefcase',
            activePage == 'bookings'
          )

          +navItem(
            '/account/reviews',
            'My reviews',
            'star',
            activePage == 'reviews'
          )

          +navItem(
            '/account/billing',
            'Billing',
            'credit-card',
            activePage == 'billing'
          )

        //- ============================
        //- ADMIN MENU
        //- ============================

        if user && user.role === 'admin'

          .admin-nav

            h5.admin-nav__heading Admin

            ul.side-nav

              +navItem(
                '/admin/manage-tours',
                'All tours',
                'map',
                activePage == 'manage-tours'
              )

              +navItem(
                '/admin/manage-users',
                'All users',
                'users',
                activePage == 'manage-users'
              )

              +navItem(
                '/admin/manage-reviews',
                'All reviews',
                'star',
                activePage == 'manage-reviews'
              )

              +navItem(
                '/admin/manage-bookings',
                'All bookings',
                'briefcase',
                activePage == 'manage-bookings'
              )

      //- ============================
      //- MAIN CONTENT
      //- ============================

      .user-view__content

        h2.heading-secondary.ma-bt-md.admin-heading
          | All Bookings

        //- ============================
        //- BOOKINGS TABLE
        //- ============================

        if bookings && bookings.length

          table

            thead
              tr
                th User
                th Tour
                th Price
                th Paid

            tbody

              each booking in bookings

                tr

                  //- User
                  td
                    if booking.user
                      | #{booking.user.name}
                    else
                      | Unknown User

                  //- Tour
                  td
                    if booking.tour
                      | #{booking.tour.name}
                    else
                      | Unknown Tour

                  //- Price
                  td
                    | $#{booking.price}

                  //- Paid
                  td
                    if booking.paid
                      | Yes
                    else
                      | No

        else

          p No bookings found.