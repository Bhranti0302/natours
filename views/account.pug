extends base

//- ==================================================
//- SIDEBAR NAVIGATION MIXIN
//- ==================================================

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=link)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view

      //- ==================================================
      //- SIDEBAR
      //- ==================================================

      nav.user-view__menu
        ul.side-nav

          +navItem(
            '/me',
            'Settings',
            'settings',
            activePage == 'settings'
          )

          +navItem(
            '/my-tours',
            'My bookings',
            'briefcase',
            activePage == 'bookings'
          )

          +navItem(
            '/account/reviews',
            'My reviews',
            'star',
            activePage == 'reviews'
          )

          +navItem(
            '/account/billing',
            'Billing',
            'credit-card',
            activePage == 'billing'
          )

        //- ==================================================
        //- ADMIN NAVIGATION
        //- ==================================================

        if user.role === 'admin'
          .admin-nav
            h5.admin-nav__heading Admin

            ul.side-nav

              //- All Tours
              +navItem(
                '/admin/manage-tours',
                'All Tours',
                'map',
                activePage == 'manage-tours'
              )

              //- All Users
              +navItem(
                '/admin/manage-users',
                'All Users',
                'users',
                activePage == 'manage-users'
              )

              //- Manage Reviews
              +navItem(
                '/admin/manage-reviews',
                'All Reviews',
                'star',
                activePage == 'manage-reviews'
              )

              //- All Booking
              +navItem(
                '/admin/manage-bookings',
                'All Booking',
                'briefcase',
                activePage == 'manage-bookings'
              )

      //- ==================================================
      //- ACCOUNT CONTENT
      //- ==================================================

      .user-view__content

        //- ==================================================
        //- ACCOUNT SETTINGS
        //- ==================================================

        .user-view__form-container

          h2.heading-secondary.ma-bt-md
            | Your account settings

          form.form.form-user-data(
            method='POST',
            action='/api/v1/users/updateMe',
            enctype='multipart/form-data'
          )

            //- ==================================================
            //- NAME
            //- ==================================================

            .form__group
              label.form__label(for='name')
                | Name

              input#name.form__input(
                type='text',
                value=user.name,
                required,
                name='name'
              )

            //- ==================================================
            //- EMAIL
            //- ==================================================

            .form__group.ma-bt-md
              label.form__label(for='email')
                | Email address

              input#email.form__input(
                type='email',
                value=user.email,
                required,
                name='email'
              )

            //- ==================================================
            //- PROFILE PHOTO
            //- ==================================================

            .form__group.form__photo-upload

              img#photo-preview.form__user-photo(
                src=user.photo && user.photo.startsWith('http')
                  ? user.photo
                  : `/img/users/${user.photo || 'default.jpg'}`,
                alt='User photo'
              )

              input#photo.form__upload(
                type='file',
                name='photo',
                accept='image/*'
              )

              label(for='photo')
                | Choose new photo

            //- ==================================================
            //- SAVE BUTTON
            //- ==================================================

            .form__group.right

              button.btn.btn--small.btn--green(
                type='submit'
              )
                | Save settings

        //- ==================================================
        //- IMAGE PREVIEW SCRIPT
        //- ==================================================

        script.
          const photoInput = document.getElementById('photo');
          const photoPreview = document.getElementById('photo-preview');

          const originalSrc = photoPreview
            ? photoPreview.src
            : '';

          if (photoInput && photoPreview) {

            photoInput.addEventListener('change', (e) => {

              const file = e.target.files[0];

              //- No file selected
              if (!file) {
                photoPreview.src = originalSrc;
                return;
              }

              //- Validate image
              if (!file.type.startsWith('image/')) {
                alert('Please select a valid image file');

                photoInput.value = '';

                photoPreview.src = originalSrc;

                return;
              }

              //- Revoke previous object URL
              if (photoPreview.dataset.objectUrl) {

                URL.revokeObjectURL(
                  photoPreview.dataset.objectUrl
                );

              }

              //- Create preview URL
              const objectUrl = URL.createObjectURL(file);

              photoPreview.src = objectUrl;

              photoPreview.dataset.objectUrl = objectUrl;

            });

          }